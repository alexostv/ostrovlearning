      "answers": ["оспиталь", "Оспиталь"],
      "hint": "Помни: H не читается",
      "explanation": "H в испанском молчит, поэтому начало слова — на 'о'."
    },
    {
      "id": "ex5",
      "type": "matching",
      "question": "Сопоставь буквы и их произношение:",
      "pairs": [
        { "left": "J", "right": "[х]" },
        { "left": "H", "right": "не читается" },
        { "left": "Ñ", "right": "[нь]" },
        { "left": "LL", "right": "[й] / [ль]" }
      ],
      "explanation": "Это четыре самые важные особенности испанского произношения."
    }
  ]
}